# Repo root (parent of agent/)
BLENDER_ASSIST_ROOT=

# Blender TCP bridge
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=8765

# Output directory for renders / STL
BLENDER_ASSIST_OUTPUT_DIR=

# Cursor SDK (orchestrator cloud runs)
CURSOR_API_KEY=
BLENDER_ASSIST_REPO_URL=https://github.com/EPIRjewelry/Blender_assist

# OpenRouter (planning / auditor summaries)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Human approval gateway
TRIGGER_GATEWAY_URL=
TRIGGER_HMAC_SECRET=

# Google (optional — paced sync skips when unset)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SYNC_DELAY_MS=120000
GOOGLE_SHEETS_DELAY_MS=900000

# Notifications (optional)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
NOTIFY_WHATSAPP_TO=
