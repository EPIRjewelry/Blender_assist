# Blender HTTP relay — copy to .env (optional; defaults work for Operator Studio)
# Relay auth off by default (RELAY_AUTH=0). Set RELAY_AUTH=1 only if you want Bearer on relay.

RELAY_AUTH=0

# Relay bind (local only — expose via named cloudflared tunnel)
RELAY_HTTP_HOST=127.0.0.1
RELAY_HTTP_PORT=9876

# Blender addon TCP bridge
BLENDER_BRIDGE_HOST=127.0.0.1
BLENDER_BRIDGE_PORT=8765

# Named Cloudflare tunnel (must match cloudflared tunnel list)
BLENDER_CLOUDFLARED_TUNNEL=epir-blender-bridge
BLENDER_BRIDGE_HOSTNAME=blender-bridge.epirbizuteria.pl
BLENDER_RELAY_URL=http://127.0.0.1:9876
